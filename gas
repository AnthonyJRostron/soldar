pb:['Soplete suave y varilla de plomo. Respirador P3, guantes, ventilación y lavado de manos.','Soft flame and lead rod. P3 respirator, gloves, ventilation and hand washing.']};
const TK={res_mild:'mild',res_assume:'mild',res_high:'high',res_gray:'cast',res_ductile:'cast',res_white:'white',res_mart:'ss',res_ferr:'ss',res_304:'ss',res_316:'ss',res_1:'al',res_5:'al',res_6:'al',res_alucast:'al',res_copper:'cu',res_brass:'brass',res_bronze:'bronze',res_gold:'gold',res_silver:'silver',res_platinum:'pt',res_tungsten:'w',res_ti:'ti',res_lead:'pb'};
const USE={carbon:'steel',cast:'cast'};let ID={node:'magnet',prev:[]};
function openId(){ID={node:'magnet',prev:[]};$('wizOv').classList.add('show');rId()}
function rId(){const n=ID.node,b=$('wizBody');$('wizT').textContent='🧠 '+t('Identificador de metal','Metal identifier');let h;
if(RES[n]){const r=RES[n],g=GT[TK[n]],u=n==='res_copper'?'copper':USE[r[0]];h=`<div class="wizard-result"><h4>${t('Metal identificado','Metal identified')}</h4><div class="reco">${tr(r[1])}</div><div class="detail">${tr(r[2])}</div><div class="reason">🔥 ${t(g[0],g[1])}<br>${t('Identificación orientativa: confirma con una probeta.','Indicative identification: confirm with a test piece.')}</div></div><div class="wizard-nav"><button class="back" id="idB">← ${t('Atrás','Back')}</button><button class="next" id="idN">${u?t('Usar y continuar →','Use and continue →'):t('Identificar otro','Identify another')}</button></div>`;
setTimeout(()=>{$('idN').onclick=()=>{if(u){S.mat=u;mode='weld';$('wizOv').classList.remove('show');rCalc()}else{ID={node:'magnet',prev:[]};rId()}}},0)}
else{const q=IDENT[n];h=`<div class="wizard-step active"><h3>${tr(q.t)}</h3><p class="hint">${tr(q.h)}</p>${q.o.map((o,i)=>`<button class="wizard-option" data-i="${i}"><strong>${tr(o[0])}</strong></button>`).join('')}</div><div class="wizard-nav"><button class="back" id="idB">← ${t('Atrás','Back')}</button></div>`}
b.innerHTML=h;b.querySelectorAll('.wizard-option').forEach(x=>x.onclick=()=>{ID.prev.push(n);ID.node=IDENT[n].o[+x.dataset.i][1];rId()});
$('idB').onclick=()=>{if(ID.prev.length){ID.node=ID.prev.pop();rId()}else $('wizOv').classList.remove('show')}}
$('wizX').onclick=()=>$('wizOv').classList.remove('show');
function toast(m){const e=$('toast');e.textContent=m;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),2500)}
function renderAll(){document.documentElement.lang=lang;$('bottomNav').innerHTML=[['calc','🧮','Calcular','Calculate'],['reference','📊','Tablas','Tables'],['equip','🧰','Pasos','Steps'],['mach','⚙️','Máquina','Machine'],['guide','📖','Guía','Guide'],['safety','🦺','Seguridad','Safety']].map(n=>`<button class="nav-btn${n[0]===tab?' active':''}" data-tab="${n[0]}"><span class="icon">${n[1]}</span><span>${t(n[2],n[3])}</span></button>`).join('');
document.querySelectorAll('.nav-btn').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id==='tab-'+tab));document.querySelectorAll('.nav-btn').forEach(x=>x.classList.toggle('active',x===b));$('content').scrollTo({top:0})});
document.querySelectorAll('#langToggle button').forEach(b=>b.classList.toggle('active',b.dataset.lang===lang));document.querySelectorAll('#unitToggle button').forEach(b=>b.classList.toggle('active',b.dataset.unit===units));
rCalc();rRef();rEquip();rMach();rGuide();rSafe()}
document.querySelectorAll('#langToggle button').forEach(b=>b.onclick=()=>{lang=b.dataset.lang;L.gasAR_lang=lang;renderAll()});
document.querySelectorAll('#unitToggle button').forEach(b=>b.onclick=()=>{units=b.dataset.unit;L.gasAR_units=units;renderAll()});
$('btnReset').onclick=()=>{S={...D};mode='weld';renderAll()};
renderAll();
</script></body></html>
