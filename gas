const RES={
res_mild:['carbon','Acero suave (bajo carbono)','Perfiles, tubos y chapa comunes (tipo S235/S275/A36). Es el más fácil de soldar.','Electrodo E6013 o E7018; hilo MIG ER70S-6.'],
